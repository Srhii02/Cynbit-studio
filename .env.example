# Copy to .env and adjust. Never commit your real .env file.

# Optional – enables "Ask Gemini" coaching. Leave empty to run 100% locally.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Embeddings: auto (MiniLM, falls back to TF-IDF+LSA if unavailable) | transformer (require MiniLM) | tfidf
CYNBIT_EMBEDDING_BACKEND=auto
CYNBIT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CYNBIT_SPACY_MODEL=en_core_web_sm

# Local SQLite history (stores scores + resume fingerprint only, never raw resume text)
CYNBIT_DB_PATH=.data/cynbit_studio.db
CYNBIT_STORE_HISTORY=true
CYNBIT_MAX_UPLOAD_MB=5
